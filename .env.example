# Copy to .env and fill in. Get Supabase keys with:
#   npx supabase projects api-keys --project-ref <your-project-ref>
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""          # anon key
SUPABASE_SERVICE_ROLE_KEY=""         # service_role key — server-side only

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""     # anon key again

# FastAPI extraction service (backend/)
EXTRACTION_API_URL="http://localhost:8000"

# Optional: your WhatsApp number for the "Upgrade" button on the Billing page
# VITE_SUPPORT_PHONE="9198xxxxxxxx"

# AI provider: "anthropic" (default) or "gemini". Anthropic needs ANTHROPIC_API_KEY.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# GST verification (business name + filing status → filer rating).
# Default provider is Appyflow (appyflow.in) — get a key_secret at
# https://dashboard.gstapi.appyflow.in (50 free lookups). Just set GST_API_KEY.
# GST_API_KEY=
# To use a different Bearer-auth provider instead, also set GST_API_URL
# (use {gstin} as an in-path placeholder if needed):
# GST_API_URL=https://api.provider.com/gstin/{gstin}

# Copy to backend/.env
# Get a free key at https://aistudio.google.com/apikey — needed for the AI
# engine (/extract) and HSN suggestions; the OCR engine works without it.
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Comma-separated origins allowed to call this API directly (browser CORS).
# Server-to-server calls from the web app are unaffected. Leave unset = allow all.
# ALLOWED_ORIGINS=https://yourapp.vercel.app

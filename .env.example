# Copy to .env and fill in. Get Supabase keys with:
#   npx supabase projects api-keys --project-ref <your-project-ref>
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""          # anon key
SUPABASE_SERVICE_ROLE_KEY=""         # service_role key — server-side only

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""     # anon key again

# FastAPI extraction service (backend/)
EXTRACTION_API_URL="http://localhost:8000"

# Optional: your WhatsApp number for the "Upgrade" button on the Billing page
# VITE_SUPPORT_PHONE="9198xxxxxxxx"

# AI provider: "anthropic" (default) or "gemini". Anthropic needs ANTHROPIC_API_KEY.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# GST verification. Default provider is Tally's free public tool (no key,
# returns real business name/address/status). Nothing to set for that.
# If you ALSO configure a paid key below, it's used automatically as a
# fallback whenever Tally errors or returns nothing (free-first, paid backup):
#   GST_API_KEY=<appyflow key_secret>                     (Appyflow fallback)
#   or GST_API_URL=https://gsp.example/gstin/{gstin}  +  GST_API_KEY=<bearer>
# To make the paid API the PRIMARY (Tally becomes the fallback) set:
#   GST_PROVIDER=appyflow   (or GST_PROVIDER=generic for GST_API_URL)
